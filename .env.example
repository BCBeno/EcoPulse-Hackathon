# Copy to .env (never committed). Every value has a working default for local development.

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://ecopulse:ecopulse@localhost:5433/ecopulse
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated lists.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Proxies allowed to set CF-Connecting-IP / X-Forwarded-For (IPs or CIDRs).
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Internal endpoints stay closed while this is empty.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

CITY_NAME=Iași
CITY_TIMEZONE=Europe/Bucharest
CITY_BBOX=47.05,27.40,47.26,27.75

AGENT_DAILY_MESSAGES=30
# Stop calling LLMs for everyone after this many tokens per day (stay under the free tiers).
AGENT_DAILY_TOKEN_BUDGET=400000
# Per-IP limits are high on purpose: a room full of phones shares one Wi-Fi IP.
DEVICES_PER_HOUR_PER_IP=300
READS_PER_MINUTE_PER_IP=1500
GEOCODE_PER_MINUTE_PER_IP=300
ROUTES_PER_MINUTE_PER_IP=150
WRITES_PER_MINUTE_PER_DEVICE=20

# --- Routing ---
GRAPHHOPPER_URL=http://localhost:8989

# --- Data sources ---
# Free key from https://explore.openaq.org/register ; empty = OpenAQ is skipped.
OPENAQ_API_KEY=

# --- AI agent (OpenAI-compatible providers, tried in this order; empty key = skipped) ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Key from https://openrouter.ai/keys ; pick a model with tool calling (a ":free" one stays free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
