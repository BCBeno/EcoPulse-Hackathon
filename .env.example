# Copy to .env (never committed). Every value has a working default for local development.

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://ecopulse:ecopulse@localhost:5433/ecopulse
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated lists.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Proxies allowed to set CF-Connecting-IP / X-Forwarded-For (IPs or CIDRs).
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Internal endpoints stay closed while this is empty.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

CITY_NAME=Iași
CITY_TIMEZONE=Europe/Bucharest
CITY_BBOX=47.05,27.40,47.26,27.75

AGENT_DAILY_MESSAGES=30
DEVICES_PER_HOUR_PER_IP=20
READS_PER_MINUTE_PER_IP=120
WRITES_PER_MINUTE_PER_DEVICE=20
