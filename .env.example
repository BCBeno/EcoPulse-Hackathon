# Public configuration example. Keep real credentials in the ignored .env.
APP_ENV=development
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CITY_NAME=Iasi
CITY_TIMEZONE=Europe/Bucharest
CITY_BBOX=47.05,27.40,47.26,27.75
USER_AGENT=EcoPulse/0.1 (local environmental navigation research)
OPENAQ_API_KEY=
OPENAQ_LOCATION_IDS=
SOURCE_SENSOR_ALIASES={}
OPENAQ_ENABLED=true
SENSOR_COMMUNITY_ENABLED=true
OPENMETEO_WEATHER_ENABLED=true
OPENMETEO_AIR_QUALITY_ENABLED=true
OSM_FEATURES_ENABLED=true
SOURCE_SYNC_ENABLED=true
SENSOR_COMMUNITY_SYNC_INTERVAL_MINUTES=10
OPENAQ_SYNC_INTERVAL_MINUTES=60
WEATHER_SYNC_INTERVAL_MINUTES=60
CAMS_SYNC_INTERVAL_MINUTES=180
OSM_SYNC_INTERVAL_HOURS=24
OFFICIAL_WORKS_ENABLED=false
OFFICIAL_WORKS_FEED_URL=
OFFICIAL_WORKS_ALLOWED_HOST=politialocala-iasi.ro
OFFICIAL_WORKS_SYNC_INTERVAL_HOURS=12
VALHALLA_BASE_URL=
MOTORCYCLE_ENABLED=false
ROUTE_AVOIDANCE_RADIUS_M=150
ROUTE_MAX_AVOIDANCE_ZONES=8
ROUTE_MAX_DETOUR_ATTEMPTS=3
ROUTE_EXCLUSION_VERTEX_BUDGET=100
ROUTE_DETOUR_TIMEOUT_SECONDS=20
ROUTE_MAX_DETOUR_RATIO=2
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
FORECAST_DAYS=3
LLM_PROVIDER=
