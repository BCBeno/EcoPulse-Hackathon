  "info": {
    "description": "Calitatea aerului, trasee curate și rapoarte comunitare pentru Iași. Contractul complet: docs/api-contract.md.",
    "title": "EcoPulse API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "operationId": "public_config_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Public Config",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/devices": {
      "post": {
        "operationId": "create_device_api_v1_devices_post",
